# ---- apps/api ----
DATABASE_URL="postgresql://kiro:kiro@localhost:5433/kiro?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN_SECONDS=3600
LOG_LEVEL="info"

# ---- apps/web ----
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- apps/ai (all overridable, OpenAI-compatible endpoints) ----
AI_SERVICE_URL="http://localhost:8000"             # used by apps/api
AI_LLM_BASE_URL="https://api.openai.com/v1"        # OpenAI-compatible chat endpoint
AI_LLM_API_KEY=""                                  # e.g. sk-... (set yours)
AI_LLM_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"        # must output 1536-dim vectors (match pgvector)
AI_EMBEDDING_DIMENSIONS=1536
