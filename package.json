{
  "name": "kiro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "proxy-addr": "^2.0.8",
      "multer": "^2.4.0",
      "lodash": "^4.18.0",
      "postcss": "^8.5.23",
      "qs": "^6.16.0",
      "body-parser": "^1.20.6",
      "deepmerge-ts": "^8.0.0",
      "file-type": "^21.3.2"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "infra": "docker compose up -d postgres redis",
    "db:setup": "pnpm --filter @kiro/api prisma:generate && pnpm --filter @kiro/api prisma:deploy",
    "setup": "pnpm install && pnpm db:setup && pnpm --filter @kiro/ai run setup",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "railway": "^3.13.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "description": "Kiro — a permission-aware company knowledge desk with source-backed answers.",
  "author": {
    "name": "Alisha Karma",
    "email": "lishykarma99@gmail.com",
    "url": "https://alishakarma.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codealisha99/kiro.git"
  },
  "bugs": {
    "url": "https://github.com/codealisha99/kiro/issues"
  }
}
